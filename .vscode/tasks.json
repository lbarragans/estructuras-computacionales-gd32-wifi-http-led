{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Verify GD32 Environment",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/verify_environment.ps1"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Build + Flash Original WiFi",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/build_wifi.ps1", "-Variant", "original", "-Clean", "-Flash"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Build + Flash Assembly",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/build_assembly.ps1", "-Clean", "-Flash"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Build + Flash FreeRTOS WiFi",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/build_wifi.ps1", "-Variant", "freertos", "-Clean", "-Flash"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Open local HTTP panel",
      "type": "process",
      "command": "C:/Windows/System32/cmd.exe",
      "args": ["/c", "start", "", "${workspaceFolder}/Web/GD32_LED_CONTROL_LOCAL.html"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "never" }
    }
  ]
}
